# End-to-end runs use synthetic data and an isolated CTest working directory.
function(run_case program input expected)
  file(WRITE "stdin.txt" "${input}")
  execute_process(COMMAND "${program}" INPUT_FILE stdin.txt
    OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic RESULT_VARIABLE result TIMEOUT 5)
  if(NOT result EQUAL expected)
    message(FATAL_ERROR "${program}: expected ${expected}, got ${result}: ${output} ${diagnostic}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(expect_file path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
  endif()
endfunction()
run_case("${EVEN}" "5\n1 2 -4 5 6\n" 0)
if(NOT last_output MATCHES "Vettore pari: 2 -4 6")
  message(FATAL_ERROR "Even-number filtering failed: ${last_output}")
endif()
run_case("${EVEN}" "2\n1 3\n" 0)
run_case("${EVEN}" "2\n1\n" 1)
run_case("${SUM}" "10\n" 0)
if(NOT last_output MATCHES "55")
  message(FATAL_ERROR "Recursive sum failed")
endif()
run_case("${SUM}" "1001\n" 1)
file(WRITE es_2_studenti.txt "Anna 1 28\nBruno 2 29.8\n")
run_case("${BONUS}" "" 0)
expect_file(es_2_studenti_bonus.txt "Anna 1 28.00\nBruno 2 30.00\n")
file(WRITE es_2_studenti.txt "Invalid 1 nan\n")
run_case("${BONUS}" "" 1)
file(WRITE es_3_meteo.txt "Roma 10 40\nCatania 20 50\n")
run_case("${WEATHER}" "" 0)
if(NOT last_output MATCHES "max: 20.00" OR NOT last_output MATCHES "media: 15.00")
  message(FATAL_ERROR "Weather calculation failed: ${last_output}")
endif()
file(WRITE es_3_meteo.txt "Bad 10 150\n")
run_case("${WEATHER}" "" 1)
file(WRITE es_4_libri.txt "Later 2020 4\nFirst 1990 2\n")
run_case("${BOOKS}" "" 0)
expect_file(libri_ordinati.txt "First 1990 2.00\nLater 2020 4.00\n")
file(WRITE es_4_libri.txt "Bad 2020 -2\n")
run_case("${BOOKS}" "" 1)
file(WRITE es_5_prestiti_libri.txt "S1 Book P01 12 10\nS2 Other P02 4 10\n")
run_case("${LOANS}" "" 0)
expect_file(es_5_ritardi_prestiti.txt "S1 Book P01 2\n")
file(WRITE es_5_prestiti_libri.txt "Truncated\n")
run_case("${LOANS}" "" 1)
file(WRITE Spedizioni.txt "2\nCatania Roma A01 100 25\nRoma Napoli B02 100 100\n")
run_case("${SHIPMENTS}" "pending.txt\n" 0)
expect_file(pending.txt "Catania Roma A01 75\n")
file(WRITE Spedizioni.txt "2\nTruncated\n")
run_case("${SHIPMENTS}" "" 1)
file(WRITE es_6_esito_esami.txt "S1 C 20 22 0.70\nS2 C 17 20 0.90\n")
run_case("${EXAMS}" "1\n2\n3\n4\nC\n5\n6\nids.txt\n20\n7\nS2\n24\n26\n2\n0\n" 0)
expect_file(insufficienti.txt "S2 C 18.50 0.90\n")
expect_file(ids.txt "S1\n")
if(NOT last_output MATCHES "SUPERATO 27" OR NOT last_output MATCHES "Media presenze: 0.70")
  message(FATAL_ERROR "Exam menu calculation failed: ${last_output}")
endif()
# Each scanner must reject partial/extra/oversized records rather than keep garbage.
foreach(pair "${BONUS}|es_2_studenti.txt" "${WEATHER}|es_3_meteo.txt" "${BOOKS}|es_4_libri.txt" "${LOANS}|es_5_prestiti_libri.txt")
  string(REPLACE "|" ";" fields "${pair}")
  list(GET fields 0 program)
  list(GET fields 1 input_file)
  file(WRITE "${input_file}" "invalid\n")
  run_case("${program}" "" 1)
  file(WRITE "${input_file}" "")
  run_case("${program}" "" 0)
  file(REMOVE "${input_file}")
  run_case("${program}" "" 1)
endforeach()
# Verify the recovered historical inputs against their archived outputs too.
file(COPY "${SAMPLES}/eser27march/" DESTINATION ".")
file(COPY "${SAMPLES}/shipments/" DESTINATION ".")
run_case("${BONUS}" "" 0)
file(READ expected_bonus.txt expected)
expect_file(es_2_studenti_bonus.txt "${expected}")
run_case("${BOOKS}" "" 0)
file(READ expected_books.txt expected)
expect_file(libri_ordinati.txt "${expected}")
run_case("${LOANS}" "" 0)
file(READ expected_loans.txt expected)
expect_file(es_5_ritardi_prestiti.txt "${expected}")
run_case("${SHIPMENTS}" "pending.txt\n" 0)
file(READ expected_pending.txt expected)
expect_file(pending.txt "${expected}")
run_case("${WEATHER}" "" 0)
if(NOT last_output MATCHES "media: 12.19" OR NOT last_output MATCHES "max: 21.30")
  message(FATAL_ERROR "Recovered weather data failed: ${last_output}")
endif()
run_case("${EXAMS}" "1\n2\n3\n5\n0\n" 0)
if(NOT last_output MATCHES "Caricati 15 record" OR NOT last_output MATCHES "Media presenze: 0.84")
  message(FATAL_ERROR "Recovered exam data failed: ${last_output}")
endif()
